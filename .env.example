# Copie para .env (ignorado pelo Git). Somente metadados públicos, sem tokens ou senhas.
# Obtenha estes três valores no provedor OAuth 2.0 externo.
SECURITY_ISSUER_URI=
SECURITY_JWK_SET_URI=
SECURITY_AUDIENCE=
# Caminho absoluto do arquivo de senha FORA do repositório; veja docs/execucao.md.
DB_PASSWORD_FILE=
APP_PORT=8080
SWAGGER_ENABLED=true
